FROM docker.io/library/rust:1.99.1-slim-trixie@sha256:b8e062b1c3a80183df83d9ba187cadd2b5ab84bc78d453dbfeb2fccd5f982247 AS build
WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY worker/Cargo.toml worker/Cargo.toml
COPY worker/src worker/src
RUN cargo build --release --locked -p falcone-serverless-worker

FROM gcr.io/distroless/cc-debian13:nonroot@sha256:3ee00291cf386ec52a552e6a858d555debd74776eb4bfa53fa3df2cd6677515e
COPY --from=build /build/target/release/falcone-serverless-worker /usr/local/bin/falcone-serverless-worker
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/falcone-serverless-worker"]
