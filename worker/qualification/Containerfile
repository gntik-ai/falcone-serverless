FROM docker.io/library/rust:1.99.1-slim-trixie@sha256:b8e062b1c3a80183df83d9ba187cadd2b5ab84bc78d453dbfeb2fccd5f982247 AS build
WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY compiler/Cargo.toml compiler/Cargo.toml
COPY compiler/src compiler/src
COPY worker/Cargo.toml worker/Cargo.toml
COPY worker/src worker/src
# The qualification feature adds the test hooks of the execution API server that the
# execute-api runner needs; the production worker/Containerfile never enables it.
RUN cargo build --release --locked -p falcone-serverless-worker --features qualification --bin qualification_runner --bin compile-cache-qualification --bin artifact-compile-child --bin execute-api-qualification

FROM gcr.io/distroless/cc-debian13:nonroot@sha256:3ee00291cf386ec52a552e6a858d555debd74776eb4bfa53fa3df2cd6677515e
# Root-owned, readable and executable by any UID, writable by none. The guests are embedded.
COPY --from=build --chmod=0555 /build/target/release/qualification_runner /usr/local/bin/qualification_runner
COPY --from=build --chmod=0555 /build/target/release/compile-cache-qualification /usr/local/bin/compile-cache-qualification
COPY --from=build --chmod=0555 /build/target/release/artifact-compile-child /usr/local/bin/artifact-compile-child
COPY --from=build --chmod=0555 /build/target/release/execute-api-qualification /usr/local/bin/execute-api-qualification
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/qualification_runner"]
