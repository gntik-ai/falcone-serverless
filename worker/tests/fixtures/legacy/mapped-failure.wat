;; Synthesized host/adapter seam, not evidence that a JS engine has been qualified.
(component
  (import "falcone:host/logging@0.2.0" (instance $logging
    (type $e (variant (case "denied") (case "limit-exceeded") (case "timeout") (case "cancelled")))
    (export "host-error" (type $error (eq $e)))
    (type $l (enum "debug" "info" "warn" "error"))
    (export "level" (type $level (eq $l)))
    (type $f (record (field "name" string) (field "value" string)))
    (export "field" (type $field (eq $f)))
    (export "log" (func (param "severity" $level) (param "message" string)
      (param "fields" (list $field)) (result (result (error $error)))))))
  (core module $memory
    (memory (export "memory") 2)
    (global $heap (mut i32) (i32.const 8192))
    (func (export "realloc") (param i32 i32 i32) (param $size i32) (result i32)
      (local $ptr i32)
      global.get $heap local.tee $ptr local.get $size i32.add global.set $heap local.get $ptr))
  (core instance $memory (instantiate $memory))
  (alias core export $memory "memory" (core memory $mem))
  (alias export $logging "log" (func $log))
  (core func $log (canon lower (func $log) (memory $mem)))
  (core module $guest
    (import "host" "memory" (memory 2))
    (import "host" "log" (func $log (param i32 i32 i32 i32 i32 i32)))
    (data (i32.const 512) "handler started")
    (data (i32.const 544) "handler finished")
    (data (i32.const 576) "synthetic error")
    (func (export "handle") (param i32 i32) (result i32)
      (call $log (i32.const 1) (i32.const 512) (i32.const 15) (i32.const 0) (i32.const 0) (i32.const 128))
      (call $log (i32.const 1) (i32.const 544) (i32.const 16) (i32.const 0) (i32.const 0) (i32.const 128))
      (i32.store (i32.const 0) (i32.const 1))
      (i32.store (i32.const 4) (i32.const 1))
      (i32.store (i32.const 8) (i32.const 576))
      (i32.store (i32.const 12) (i32.const 15))
      (i32.const 0)))
  (core instance $host (export "memory" (memory $mem)) (export "log" (func $log)))
  (core instance $guest (instantiate $guest (with "host" (instance $host))))
  (type $bytes (list u8))
  (type $error (variant (case "invalid-input" string) (case "failed" string)))
  (func $handle (param "params" $bytes) (result (result $bytes (error $error)))
    (canon lift (core func $guest "handle") (memory $mem) (realloc (func $memory "realloc")) string-encoding=utf8))
  (instance $handler (export "handler-error" (type $error)) (export "handle" (func $handle)))
  (export "falcone:host/handler@0.2.0" (instance $handler)))
