(component
  (import "falcone:host/logging@0.2.0" (instance $logging
    (type $error-type (variant (case "denied") (case "limit-exceeded") (case "timeout") (case "cancelled")))
    (export "host-error" (type $host-error (eq $error-type)))
    (type $level-type (enum "debug" "info" "warn" "error"))
    (export "level" (type $level (eq $level-type)))
    (type $field-type (record (field "name" string) (field "value" string)))
    (export "field" (type $field (eq $field-type)))
    (export "log" (func (param "severity" $level) (param "message" string) (param "fields" (list $field)) (result (result (error $host-error)))))))
  (core module $memory (memory (export "memory") 1))
  (core instance $memory (instantiate $memory))
  (alias core export $memory "memory" (core memory $memory))
  (alias export $logging "log" (func $log))
  (core func $log (canon lower (func $log) (memory $memory) string-encoding=utf8))
  (core instance $host (export "memory" (memory $memory)) (export "log" (func $log)))
  (core module $guest
    (import "host" "memory" (memory 1))
    (import "host" "log" (func $log (param i32 i32 i32 i32 i32 i32)))
    (func (export "realloc") (param i32 i32 i32 i32) (result i32) i32.const 1024)
    ;; A field with a one-byte name and value, plus a nonempty message.
    (data (i32.const 64) "kv")
    (func (export "handle") (param $ptr i32) (param i32) (result i32)
      (local $len i32)
      (local.set $len (i32.load (local.get $ptr)))
      (memory.fill (i32.const 2048) (i32.const 97) (local.get $len))
      (i32.store (i32.const 80) (i32.const 64))
      (i32.store (i32.const 84) (i32.const 1))
      (i32.store (i32.const 88) (i32.const 65))
      (i32.store (i32.const 92) (i32.const 1))
      (call $log (i32.const 1) (i32.const 2048) (local.get $len) (i32.const 80) (i32.const 1) (i32.const 16))
      ;; Echo the host's result tag and host-error discriminant to the caller.
      (i32.store (i32.const 32) (i32.const 0))
      (i32.store (i32.const 36) (i32.const 16))
      (i32.store (i32.const 40) (i32.const 2))
      i32.const 32)
    ;; Invalidate the returned payload during cleanup. The caller must have
    ;; already bounded and copied it, rather than retaining lazy guest cursors.
    (func (export "post-return") (param i32)
      (memory.fill (i32.const 16) (i32.const 0) (i32.const 2))))
  (core instance $guest (instantiate $guest (with "host" (instance $host))))
  (type $bytes (list u8))
  (type $error (variant (case "invalid-input" string) (case "failed" string)))
  (type $result (result $bytes (error $error)))
  (func $handle (param "params" $bytes) (result $result)
    (canon lift (core func $guest "handle") (memory $memory) (realloc (func $guest "realloc")) (post-return (func $guest "post-return")) string-encoding=utf8))
  (instance $handler (export "handler-error" (type $error)) (export "handle" (func $handle)))
  (export "falcone:host/handler@0.2.0" (instance $handler)))
