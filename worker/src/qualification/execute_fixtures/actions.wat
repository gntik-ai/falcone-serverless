(component
  (import "falcone:host/progress@0.2.0" (instance $progress
    (type $error-type (variant (case "denied") (case "limit-exceeded") (case "timeout") (case "cancelled")))
    (export "host-error" (type $host-error (eq $error-type)))
    (export "report" (func (param "completed" u64) (param "total" u64) (param "message" string) (result (result (error $host-error)))))))
  (core module $memory (memory (export "memory") 64 64))
  (core instance $memory (instantiate $memory))
  (alias core export $memory "memory" (core memory $memory))
  (alias export $progress "report" (func $report))
  (core func $report (canon lower (func $report) (memory $memory) string-encoding=utf8))
  (core instance $host (export "memory" (memory $memory)) (export "report" (func $report)))
  (core module $guest
    (import "host" "memory" (memory 64 64))
    (import "host" "report" (func $report (param i64 i64 i32 i32 i32)))
    (func (export "realloc") (param i32 i32 i32 i32) (result i32) i32.const 1024)
    ;; params = little-endian payload length, outcome (0=ok,1=invalid,2=failed), action (1=host call,2=loop).
    (func (export "handle") (param $ptr i32) (param i32) (result i32)
      (local $len i32) (local $kind i32) (local $action i32)
      (local.set $len (i32.load (local.get $ptr)))
      (local.set $kind (i32.load8_u offset=4 (local.get $ptr)))
      (local.set $action (i32.load8_u offset=5 (local.get $ptr)))
      (if (i32.eq (local.get $action) (i32.const 1)) (then
        (call $report (i64.const 1) (i64.const 1) (i32.const 0) (i32.const 0) (i32.const 16))))
      (if (i32.eq (local.get $action) (i32.const 2)) (then (loop br 0)))
      (memory.fill (i32.const 65536) (i32.const 97) (local.get $len))
      (if (i32.eqz (local.get $kind))
        (then
          (i32.store (i32.const 32) (i32.const 0))
          (i32.store (i32.const 36) (i32.const 65536))
          (i32.store (i32.const 40) (local.get $len)))
        (else
          (i32.store (i32.const 32) (i32.const 1))
          (i32.store (i32.const 36) (i32.sub (local.get $kind) (i32.const 1)))
          (i32.store (i32.const 40) (i32.const 65536))
          (i32.store (i32.const 44) (local.get $len))))
      i32.const 32))
  (core instance $guest (instantiate $guest (with "host" (instance $host))))
  (type $bytes (list u8))
  (type $error (variant (case "invalid-input" string) (case "failed" string)))
  (type $result (result $bytes (error $error)))
  (func $handle (param "params" $bytes) (result $result)
    (canon lift (core func $guest "handle") (memory $memory) (realloc (func $guest "realloc")) string-encoding=utf8))
  (instance $handler (export "handler-error" (type $error)) (export "handle" (func $handle)))
  (export "falcone:host/handler@0.2.0" (instance $handler)))
