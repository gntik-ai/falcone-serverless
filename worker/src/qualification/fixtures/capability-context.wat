(component
  (import "falcone:host/cancellation@0.1.0" (instance $cancel (export "is-cancelled" (func (result bool)))))
  (import "falcone:host/progress@0.1.0" (instance $progress
    (type $error-type (variant (case "denied") (case "limit-exceeded") (case "timeout") (case "cancelled")))
    (export "host-error" (type $error (eq $error-type)))
    (export "report" (func (param "completed" u64) (param "total" u64) (param "message" string) (result (result (error $error)))))))
  (import "falcone:host/invocation-context@0.1.0" (instance $context (export "invocation-key" (func (result string)))))
  (core module $memory
    (memory (export "memory") 1 1)
    (func (export "realloc") (param i32 i32 i32 i32) (result i32) (i32.const 1024)))
  (core instance $memory (instantiate $memory))
  (alias core export $memory "memory" (core memory $memory))
  (alias core export $memory "realloc" (core func $realloc))
  (alias export $cancel "is-cancelled" (func $cancel))
  (alias export $progress "report" (func $report))
  (alias export $context "invocation-key" (func $context))
  (core func $cancel (canon lower (func $cancel)))
  (core func $report (canon lower (func $report) (memory $memory)))
  (core func $context (canon lower (func $context) (memory $memory) (realloc $realloc)))
  (core module $guest
    (import "host" "memory" (memory 1 1))
    (import "host" "cancel" (func $cancel (result i32)))
    (import "host" "report" (func $report (param i64 i64 i32 i32 i32)))
    (import "host" "context" (func $context (param i32)))
    (func (export "run") (param $mode i32) (result i32)
      (if (i32.eq (local.get $mode) (i32.const 0)) (then (return (call $cancel))))
      (if (i32.eq (local.get $mode) (i32.const 1)) (then
        (call $report (i64.const 1) (i64.const 2) (i32.const 0) (i32.const 0) (i32.const 0))
        (return (i32.load8_u (i32.const 0)))))
      (call $context (i32.const 0))
      (i32.and (i32.eq (i32.load (i32.const 4)) (i32.const 19))
        (i32.eq (i32.load8_u (i32.load (i32.const 0))) (i32.const 118)))))
  (core instance $host (export "memory" (memory $memory)) (export "cancel" (func $cancel)) (export "report" (func $report)) (export "context" (func $context)))
  (core instance $guest (instantiate $guest (with "host" (instance $host))))
  (func (export "run") (param "mode" u32) (result u32) (canon lift (core func $guest "run"))))
