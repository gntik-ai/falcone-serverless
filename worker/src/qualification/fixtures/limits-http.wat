(component
  (import "falcone:host/http@0.1.0" (instance $http
    (type $error-type (variant (case "denied") (case "limit-exceeded") (case "timeout") (case "cancelled")))
    (export "host-error" (type $error (eq $error-type)))
    (type $header-type (record (field "name" string) (field "value" string)))
    (export "header" (type $header (eq $header-type)))
    (type $response-type (record (field "status" u16) (field "headers" (list $header)) (field "body" (list u8))))
    (export "response" (type $response (eq $response-type)))
    (export "request" (func (param "url" string) (param "method" string) (param "headers" (list $header)) (param "body" (list u8)) (result (result $response (error $error)))))))
  (core module $memory
    (memory (export "memory") 4096 4096)
    (global $allocated (mut i32) (i32.const 0))
    (func (export "allocated") (result i32) (global.get $allocated))
    (global $heap (mut i32) (i32.const 65536))
    (func (export "realloc") (param i32 i32 i32) (param $size i32) (result i32)
      (local $ptr i32) (global.set $allocated (i32.add (global.get $allocated) (local.get $size))) (local.set $ptr (global.get $heap))
      (global.set $heap (i32.add (global.get $heap) (i32.add (local.get $size) (i32.const 8)))) (local.get $ptr)))
  (core instance $memory (instantiate $memory))
  (func (export "allocated") (result u32) (canon lift (core func $memory "allocated")))
  (alias core export $memory "memory" (core memory $memory))
  (alias core export $memory "realloc" (core func $realloc))
  (alias export $http "request" (func $request))
  (core func $request (canon lower (func $request) (memory $memory) (realloc $realloc)))
  (core module $guest
    (import "host" "memory" (memory 4096 4096))
    (import "host" "request" (func $request (param i32 i32 i32 i32 i32 i32 i32 i32 i32)))
    (data (i32.const 1024) "http://allowed.test/pathGET")
    (data (i32.const 1280) "http://unlisted.test/")
    (func (export "run") (param $mode i32) (result i32)
      (local $url i32) (local $url-len i32) (local $method i32) (local $method-len i32) (local $headers i32) (local $body i32)
      (local.set $url (i32.const 1024)) (local.set $url-len (i32.const 24))
      (local.set $method (i32.const 1048)) (local.set $method-len (i32.const 3))
      (if (i32.eq (local.get $mode) (i32.const 1)) (then (local.set $url (i32.const 1280)) (local.set $url-len (i32.const 21))))
      (if (i32.eq (local.get $mode) (i32.const 2)) (then (local.set $url (i32.const 8192)) (local.set $url-len (i32.const 201326592))))
      (if (i32.eq (local.get $mode) (i32.const 3)) (then (local.set $method (i32.const 8192)) (local.set $method-len (i32.const 201326592))))
      (if (i32.eq (local.get $mode) (i32.const 4)) (then
        (local.set $headers (i32.const 1048577))
        (i32.store (i32.const 4096) (i32.const -1)) (i32.store (i32.const 4100) (i32.const 1))))
      (if (i32.eq (local.get $mode) (i32.const 5)) (then
        (local.set $headers (i32.const 1))
        (i32.store (i32.const 4096) (i32.const 8192)) (i32.store (i32.const 4100) (i32.const 201326592))))
      (if (i32.eq (local.get $mode) (i32.const 6)) (then (local.set $body (i32.const 201326592))))
      (call $request (local.get $url) (local.get $url-len) (local.get $method) (local.get $method-len)
        (i32.const 4096) (local.get $headers) (i32.const 8192) (local.get $body) (i32.const 0))
      (if (result i32) (i32.load8_u (i32.const 0))
        (then (i32.add (i32.const 1) (i32.load8_u (i32.const 4))))
        (else (if (result i32) (i32.eq (i32.load16_u (i32.const 4)) (i32.const 200)) (then (i32.const 0)) (else (i32.const 99)))))))
  (core instance $host (export "memory" (memory $memory)) (export "request" (func $request)))
  (core instance $guest (instantiate $guest (with "host" (instance $host))))
  (func (export "run") (param "mode" u32) (result u32) (canon lift (core func $guest "run"))))
