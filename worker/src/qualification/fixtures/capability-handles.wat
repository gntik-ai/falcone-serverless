(component
  (import "falcone:host/storage@0.1.0" (instance $storage
    (type $error-type (variant (case "denied") (case "limit-exceeded") (case "timeout") (case "cancelled")))
    (export "host-error" (type $error (eq $error-type)))
    (export "object" (type $object (sub resource)))
    (export "open-object" (func (param "key" string) (result (result (own $object) (error $error)))))))
  (alias export $storage "object" (type $object))
  (core module $memory (memory (export "memory") 32 32))
  (core instance $memory (instantiate $memory))
  (alias core export $memory "memory" (core memory $memory))
  (alias export $storage "open-object" (func $open))
  (core func $open (canon lower (func $open) (memory $memory)))
  (core func $drop (canon resource.drop $object))
  (core module $guest
    (import "host" "memory" (memory 32 32))
    (import "host" "open" (func $open (param i32 i32 i32)))
    (import "host" "drop" (func $drop (param i32)))
    (data (i32.const 8192) "objects/")
    (func (export "run") (param $length i32) (param $count i32) (param $drop i32) (result i32)
      (local $index i32)
      ;; Touch guest data before the measurement warm-up, independently of handles.
      (memory.fill (i32.const 8200) (i32.const 120) (i32.const 1048564))
      (loop $again
        (call $open (i32.const 8192) (local.get $length) (i32.const 0))
        (if (i32.load8_u (i32.const 0))
          (then (return (i32.add (i32.const 1) (i32.load8_u (i32.const 4))))))
        (if (local.get $drop) (then (call $drop (i32.load (i32.const 4)))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br_if $again (i32.lt_u (local.get $index) (local.get $count))))
      (i32.const 0)))
  (core instance $host (export "memory" (memory $memory)) (export "open" (func $open)) (export "drop" (func $drop)))
  (core instance $guest (instantiate $guest (with "host" (instance $host))))
  (func (export "run") (param "length" u32) (param "count" u32) (param "drop" u32) (result u32)
    (canon lift (core func $guest "run"))))
