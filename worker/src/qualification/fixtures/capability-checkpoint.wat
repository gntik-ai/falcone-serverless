(component
  (import "falcone:host/storage@0.2.0" (instance $storage
    (type $error-type (variant (case "denied") (case "limit-exceeded") (case "timeout") (case "cancelled")))
    (export "host-error" (type $error (eq $error-type)))
    (export "checkpoint" (type $checkpoint (sub resource)))
    (export "open-checkpoint" (func (param "key" string) (result (result (own $checkpoint) (error $error)))))
    (export "read-checkpoint" (func (param "handle" (borrow $checkpoint)) (result (result (list u8) (error $error)))))
    (export "write-checkpoint" (func (param "handle" (borrow $checkpoint)) (param "data" (list u8)) (result (result (error $error)))))))
  (alias export $storage "checkpoint" (type $checkpoint))
  (import "falcone:host/progress@0.2.0" (instance $progress
    (type $error-type (variant (case "denied") (case "limit-exceeded") (case "timeout") (case "cancelled")))
    (export "host-error" (type $error (eq $error-type)))
    (export "checkpoint" (type $cp (eq $checkpoint)))
    (export "report-checkpoint" (func (param "handle" (borrow $cp)) (result (result (error $error)))))))
  (core module $memory
    (memory (export "memory") 1 1)
    (func (export "realloc") (param i32 i32 i32 i32) (result i32) (i32.const 4096)))
  (core instance $memory (instantiate $memory))
  (alias core export $memory "memory" (core memory $memory))
  (alias core export $memory "realloc" (core func $realloc))
  (alias export $storage "open-checkpoint" (func $open))
  (alias export $storage "read-checkpoint" (func $read))
  (alias export $storage "write-checkpoint" (func $write))
  (alias export $progress "report-checkpoint" (func $report))
  (core func $open (canon lower (func $open) (memory $memory)))
  (core func $read (canon lower (func $read) (memory $memory) (realloc $realloc)))
  (core func $write (canon lower (func $write) (memory $memory)))
  (core func $report (canon lower (func $report) (memory $memory)))
  (core module $guest
    (import "host" "memory" (memory 1 1))
    (import "host" "open" (func $open (param i32 i32 i32)))
    (import "host" "read" (func $read (param i32 i32)))
    (import "host" "write" (func $write (param i32 i32 i32 i32)))
    (import "host" "report" (func $report (param i32 i32)))
    (data (i32.const 1024) "objects/good")
    (data (i32.const 2048) "\2a\2b")
    (func (export "run") (param $mode i32) (result i32)
      (local $handle i32)
      (call $open (i32.const 1024) (i32.const 12) (i32.const 0))
      (if (i32.load8_u (i32.const 0)) (then (return (i32.const 99))))
      (local.set $handle (i32.load (i32.const 4)))
      (if (i32.eqz (local.get $mode)) (then
        (call $read (local.get $handle) (i32.const 0))
        (if (i32.load8_u (i32.const 0)) (then (return (i32.const 99))))
        (if (i32.ne (i32.load (i32.const 8)) (i32.const 2)) (then (return (i32.const 99))))
        (return (i32.sub (i32.load16_u (i32.load (i32.const 4))) (i32.const 11050)))))
      (if (i32.eq (local.get $mode) (i32.const 1))
        (then (call $write (local.get $handle) (i32.const 2048) (i32.const 2) (i32.const 0)))
        (else (call $report (local.get $handle) (i32.const 0))))
      (i32.load8_u (i32.const 0))))
  (core instance $host (export "memory" (memory $memory)) (export "open" (func $open)) (export "read" (func $read)) (export "write" (func $write)) (export "report" (func $report)))
  (core instance $guest (instantiate $guest (with "host" (instance $host))))
  (func (export "run") (param "mode" u32) (result u32) (canon lift (core func $guest "run"))))
