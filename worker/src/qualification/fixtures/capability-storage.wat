(component
  (import "falcone:host/storage@0.2.0" (instance $storage
    (type $error-type (variant (case "denied") (case "limit-exceeded") (case "timeout") (case "cancelled")))
    (export "host-error" (type $error (eq $error-type)))
    (export "object" (type $object (sub resource)))
    (export "open-object" (func (param "key" string) (result (result (own $object) (error $error)))))
    (export "read-object" (func (param "handle" (borrow $object)) (result (result (list u8) (error $error)))))
    (export "write-object" (func (param "handle" (borrow $object)) (param "data" (list u8)) (result (result (error $error)))))))
  (core module $memory
    (memory (export "memory") 4096 4096)
    (global $heap (mut i32) (i32.const 65536))
    (func (export "realloc") (param i32 i32 i32) (param $size i32) (result i32)
      (local $ptr i32) (local.set $ptr (global.get $heap))
      (global.set $heap (i32.add (global.get $heap) (i32.add (local.get $size) (i32.const 8))))
      (local.get $ptr)))
  (core instance $memory (instantiate $memory))
  (alias core export $memory "memory" (core memory $memory))
  (alias core export $memory "realloc" (core func $realloc))
  (alias export $storage "open-object" (func $open))
  (alias export $storage "read-object" (func $read))
  (alias export $storage "write-object" (func $write))
  (core func $open (canon lower (func $open) (memory $memory)))
  (core func $read (canon lower (func $read) (memory $memory) (realloc $realloc)))
  (core func $write (canon lower (func $write) (memory $memory)))
  (core module $guest
    (import "host" "memory" (memory 4096 4096))
    (import "host" "open" (func $open (param i32 i32 i32)))
    (import "host" "read" (func $read (param i32 i32)))
    (import "host" "write" (func $write (param i32 i32 i32 i32)))
    (data (i32.const 1024) "objects/good../escapeother/escape")
    (data (i32.const 2048) "\2a\2b")
    (func (export "run") (param $mode i32) (result i32)
      (local $ptr i32) (local $len i32) (local $handle i32)
      (local.set $ptr (i32.const 1024)) (local.set $len (i32.const 12))
      (if (i32.eq (local.get $mode) (i32.const 2)) (then (local.set $ptr (i32.const 1036)) (local.set $len (i32.const 9))))
      (if (i32.eq (local.get $mode) (i32.const 3)) (then (local.set $ptr (i32.const 1045)) (local.set $len (i32.const 12))))
      ;; Modes 5 and 6 try reading and writing the bare key outside objects/.
      (if (i32.ge_u (local.get $mode) (i32.const 5)) (then (local.set $len (i32.const 7))))
      (call $open (local.get $ptr) (local.get $len) (i32.const 0))
      (if (i32.load8_u (i32.const 0)) (then (return (i32.add (i32.const 1) (i32.load8_u (i32.const 4))))))
      (local.set $handle (i32.load (i32.const 4)))
      (if (i32.or (i32.eq (local.get $mode) (i32.const 1)) (i32.eq (local.get $mode) (i32.const 6)))
        (then (call $write (local.get $handle) (i32.const 2048) (i32.const 2) (i32.const 0)))
        (else (if (i32.eq (local.get $mode) (i32.const 4))
          (then (call $write (local.get $handle) (i32.const 4096) (i32.const 1048577) (i32.const 0)))
          (else (call $read (local.get $handle) (i32.const 0))))))
      (if (result i32) (i32.load8_u (i32.const 0))
        (then (i32.add (i32.const 1)
          (i32.load8_u (if (result i32) (i32.or (i32.or (i32.eq (local.get $mode) (i32.const 1)) (i32.eq (local.get $mode) (i32.const 4))) (i32.eq (local.get $mode) (i32.const 6)))
            (then (i32.const 1)) (else (i32.const 4))))))
        (else (i32.const 0)))))
  (core instance $host (export "memory" (memory $memory)) (export "open" (func $open)) (export "read" (func $read)) (export "write" (func $write)))
  (core instance $guest (instantiate $guest (with "host" (instance $host))))
  (func (export "run") (param "mode" u32) (result u32) (canon lift (core func $guest "run"))))
