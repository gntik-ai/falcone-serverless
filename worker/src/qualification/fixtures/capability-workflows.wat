(component
  (import "falcone:host/workflows@0.1.0" (instance $workflows
    (type $error-type (variant (case "denied") (case "limit-exceeded") (case "timeout") (case "cancelled")))
    (export "host-error" (type $error (eq $error-type)))
    (export "execution" (type $execution (sub resource)))
    (export "start" (func (param "workflow" string) (param "input" (list u8)) (result (result (own $execution) (error $error)))))
    (export "signal" (func (param "handle" (borrow $execution)) (param "name" string) (param "payload" (list u8)) (result (result (error $error)))))))
  (core module $memory (memory (export "memory") 4096 4096))
  (core instance $memory (instantiate $memory))
  (alias core export $memory "memory" (core memory $memory))
  (alias export $workflows "start" (func $start))
  (alias export $workflows "signal" (func $signal))
  (core func $start (canon lower (func $start) (memory $memory)))
  (core func $signal (canon lower (func $signal) (memory $memory)))
  (core module $guest
    (import "host" "memory" (memory 4096 4096))
    (import "host" "start" (func $start (param i32 i32 i32 i32 i32)))
    (import "host" "signal" (func $signal (param i32 i32 i32 i32 i32 i32)))
    (data (i32.const 1024) "invoiceothertick")
    (func (export "run") (param $mode i32) (result i32)
      (local $ptr i32) (local $len i32) (local $handle i32)
      (local.set $ptr (i32.const 1024)) (local.set $len (i32.const 7))
      (if (i32.eq (local.get $mode) (i32.const 1)) (then (local.set $ptr (i32.const 1031)) (local.set $len (i32.const 5))))
      (if (i32.ne (local.get $mode) (i32.const 3)) (then
        (call $start (local.get $ptr) (local.get $len) (i32.const 4096) (i32.const 0) (i32.const 0))
        (if (i32.load8_u (i32.const 0)) (then (return (i32.add (i32.const 1) (i32.load8_u (i32.const 4))))))
        (local.set $handle (i32.load (i32.const 4)))))
      (if (i32.ge_u (local.get $mode) (i32.const 2)) (then (local.set $handle (i32.const -1))))
      (call $signal (local.get $handle) (i32.const 1036) (i32.const 4) (i32.const 4096) (i32.const 0) (i32.const 0))
      (if (result i32) (i32.load8_u (i32.const 0))
        (then (i32.add (i32.const 1) (i32.load8_u (i32.const 1)))) (else (i32.const 0)))))
  (core instance $host (export "memory" (memory $memory)) (export "start" (func $start)) (export "signal" (func $signal)))
  (core instance $guest (instantiate $guest (with "host" (instance $host))))
  (func (export "run") (param "mode" u32) (result u32) (canon lift (core func $guest "run"))))
