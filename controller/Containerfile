FROM docker.io/library/golang:1.26.10-trixie@sha256:a050dcceee6eb9bf110151662dfac7662f3bec40927c7dee48731e3d92083d42 AS build
ENV GOTOOLCHAIN=local
WORKDIR /build
COPY controller/go.mod controller/main.go ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags '-s -w' -o /out/falcone-serverless-controller .

FROM gcr.io/distroless/static-debian13:nonroot@sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3
COPY --from=build /out/falcone-serverless-controller /usr/local/bin/falcone-serverless-controller
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/falcone-serverless-controller"]
