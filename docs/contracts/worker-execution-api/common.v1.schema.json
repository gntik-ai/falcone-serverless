{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:falcone:contracts:worker-execution-api:1:common",
  "title": "ctr-worker-execution-api v1: shared definitions",
  "$defs": {
    "version": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](\\.[0-9]{1,9})?Z$"
    },
    "positive": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "runtime_mode": {
      "enum": [
        "wasm",
        "oci"
      ]
    },
    "class": {
      "enum": [
        "retryable",
        "non_retryable",
        "uncertain"
      ]
    },
    "language_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "$ref": "urn:falcone:contracts:worker-execution-api:1:common#/$defs/text"
        },
        "version": {
          "$ref": "urn:falcone:contracts:worker-execution-api:1:common#/$defs/text"
        }
      }
    },
    "interface_version": {
      "const": "0.2.0"
    },
    "base": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "version",
            "digest"
          ],
          "properties": {
            "kind": {
              "const": "catalog"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "digest": {
              "$ref": "urn:falcone:contracts:worker-execution-api:1:common#/$defs/digest"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "image_digest",
            "signer_identity",
            "attestation_ref"
          ],
          "properties": {
            "kind": {
              "const": "byo"
            },
            "image_digest": {
              "$ref": "urn:falcone:contracts:worker-execution-api:1:common#/$defs/digest"
            },
            "signer_identity": {
              "$ref": "urn:falcone:contracts:worker-execution-api:1:common#/$defs/text"
            },
            "attestation_ref": {
              "$ref": "urn:falcone:contracts:worker-execution-api:1:common#/$defs/text"
            }
          }
        }
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "function_revision",
        "runtime_mode",
        "artifact_digest",
        "wasmtime_version",
        "language_profile",
        "interface_version"
      ],
      "properties": {
        "function_revision": {
          "$ref": "urn:falcone:contracts:worker-execution-api:1:common#/$defs/id"
        },
        "runtime_mode": {
          "$ref": "urn:falcone:contracts:worker-execution-api:1:common#/$defs/runtime_mode"
        },
        "artifact_digest": {
          "$ref": "urn:falcone:contracts:worker-execution-api:1:common#/$defs/digest"
        },
        "base_digest": {
          "$ref": "urn:falcone:contracts:worker-execution-api:1:common#/$defs/digest"
        },
        "wasmtime_version": {
          "$ref": "urn:falcone:contracts:worker-execution-api:1:common#/$defs/text"
        },
        "language_profile": {
          "$ref": "urn:falcone:contracts:worker-execution-api:1:common#/$defs/language_profile"
        },
        "interface_version": {
          "$ref": "urn:falcone:contracts:worker-execution-api:1:common#/$defs/interface_version"
        }
      }
    },
    "handler_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statusCode"
      ],
      "properties": {
        "statusCode": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "body": {
          "not": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "statusCode": {
            "const": 304
          }
        },
        "required": [
          "statusCode"
        ]
      },
      "then": {
        "not": {
          "required": [
            "body"
          ]
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "code",
        "message",
        "detail",
        "retryable"
      ],
      "properties": {
        "status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "code": {
          "enum": [
            "GW_OCI_NOT_AUTHORIZED",
            "GW_BASE_DISABLED",
            "GW_BASE_MISMATCH",
            "runtime_mode_not_supported",
            "invalid_request",
            "request_too_large",
            "undeclared_import",
            "busy",
            "execution_timeout",
            "execution_failed",
            "execution_uncertain",
            "not_found",
            "method_not_allowed"
          ]
        },
        "message": {
          "$ref": "urn:falcone:contracts:worker-execution-api:1:common#/$defs/text"
        },
        "detail": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason"
          ],
          "properties": {
            "reason": {
              "enum": [
                "artifact_rejected",
                "artifact_unavailable",
                "at_capacity",
                "base_disabled",
                "base_mismatch",
                "body_too_large",
                "budget_above_worker_ceiling",
                "buffer_limit_exceeded",
                "cancelled",
                "deadline_exceeded",
                "duplicate_attempt",
                "engine_version_mismatch",
                "fuel_exhausted",
                "handler_failed",
                "handler_trapped",
                "headers_too_large",
                "host_call_budget_exceeded",
                "host_call_outcome_unknown",
                "import_not_allowed",
                "import_not_declared",
                "instantiation_failed",
                "invalid_handler_output",
                "malformed_http",
                "malformed_message",
                "memory_budget_exceeded",
                "method_not_allowed",
                "missing_path",
                "non_json_body",
                "oci_not_authorized",
                "request_body_too_large",
                "runtime_mode_not_wasm",
                "unknown_execution",
                "unknown_path"
              ]
            }
          }
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": "GW_OCI_NOT_AUTHORIZED"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": 403
              },
              "retryable": {
                "const": false
              },
              "detail": {
                "properties": {
                  "reason": {
                    "enum": [
                      "oci_not_authorized"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "GW_BASE_DISABLED"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": 409
              },
              "retryable": {
                "const": false
              },
              "detail": {
                "properties": {
                  "reason": {
                    "enum": [
                      "base_disabled"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "GW_BASE_MISMATCH"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": 409
              },
              "retryable": {
                "const": false
              },
              "detail": {
                "properties": {
                  "reason": {
                    "enum": [
                      "base_mismatch"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "runtime_mode_not_supported"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": 409
              },
              "retryable": {
                "const": false
              },
              "detail": {
                "properties": {
                  "reason": {
                    "enum": [
                      "runtime_mode_not_wasm"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "invalid_request"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": 400
              },
              "retryable": {
                "const": false
              },
              "detail": {
                "properties": {
                  "reason": {
                    "enum": [
                      "missing_path",
                      "non_json_body",
                      "malformed_message",
                      "malformed_http",
                      "budget_above_worker_ceiling",
                      "engine_version_mismatch",
                      "duplicate_attempt"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "request_too_large"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": 413
              },
              "retryable": {
                "const": false
              },
              "detail": {
                "properties": {
                  "reason": {
                    "enum": [
                      "body_too_large",
                      "headers_too_large",
                      "request_body_too_large"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "undeclared_import"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": 422
              },
              "retryable": {
                "const": false
              },
              "detail": {
                "properties": {
                  "reason": {
                    "enum": [
                      "import_not_declared",
                      "import_not_allowed"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "busy"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": 503
              },
              "retryable": {
                "const": true
              },
              "detail": {
                "properties": {
                  "reason": {
                    "enum": [
                      "at_capacity"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "execution_timeout"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": 504
              },
              "retryable": {
                "const": false
              },
              "detail": {
                "properties": {
                  "reason": {
                    "enum": [
                      "deadline_exceeded"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "execution_failed"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": 500
              },
              "retryable": {
                "const": false
              },
              "detail": {
                "properties": {
                  "reason": {
                    "enum": [
                      "memory_budget_exceeded",
                      "fuel_exhausted",
                      "host_call_budget_exceeded",
                      "buffer_limit_exceeded",
                      "handler_failed",
                      "handler_trapped",
                      "invalid_handler_output",
                      "instantiation_failed",
                      "artifact_unavailable",
                      "artifact_rejected",
                      "cancelled"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "execution_uncertain"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": 502
              },
              "retryable": {
                "const": false
              },
              "detail": {
                "properties": {
                  "reason": {
                    "enum": [
                      "host_call_outcome_unknown"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "not_found"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": 404
              },
              "retryable": {
                "const": false
              },
              "detail": {
                "properties": {
                  "reason": {
                    "enum": [
                      "unknown_path",
                      "unknown_execution"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "method_not_allowed"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": 405
              },
              "retryable": {
                "const": false
              },
              "detail": {
                "properties": {
                  "reason": {
                    "enum": [
                      "method_not_allowed"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
