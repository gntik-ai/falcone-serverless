{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falcone.dev/contracts/serverless/worker-execution-api/v1/cancel",
  "title": "Worker cancel v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "activation_id",
    "attempt_id",
    "state"
  ],
  "properties": {
    "contract_version": {
      "$ref": "https://falcone.dev/contracts/serverless/worker-execution-api/v1/common#/$defs/contractVersion"
    },
    "activation_id": {
      "$ref": "https://falcone.dev/contracts/serverless/worker-execution-api/v1/common#/$defs/nonEmptyString"
    },
    "attempt_id": {
      "$ref": "https://falcone.dev/contracts/serverless/worker-execution-api/v1/common#/$defs/nonEmptyString"
    },
    "state": {
      "enum": [
        "requested",
        "acknowledged",
        "uncertain"
      ]
    }
  }
}
