{
  "controller": {
    "image": {
      "repository": "docker.io/fs-test/controller",
      "digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111"
    },
    "replicas": 2
  },
  "worker": {
    "image": {
      "repository": "docker.io/fs-test/worker",
      "digest": "sha256:2222222222222222222222222222222222222222222222222222222222222222"
    },
    "replicas": 0
  },
  "compiler": {
    "image": {
      "repository": "docker.io/fs-test/compiler",
      "digest": "sha256:3333333333333333333333333333333333333333333333333333333333333333"
    },
    "replicas": 1
  },
  "watchedPoolNamespaces": [
    "fs-test-pool-a"
  ],
  "controllerNamespace": "fs-test-controller",
  "namespaceMode": "preprovisioned",
  "poolLimits": {
    "maxPools": 100,
    "maxReplicasPerPool": 20
  },
  "prerequisites": {
    "gatewayRoute": {
      "name": "fs-test-gateway"
    },
    "storage": {
      "name": "fs-test-storage"
    },
    "broker": {
      "name": "fs-test-broker"
    },
    "rbac": {
      "controllerRoleBinding": "fs-test-controller"
    },
    "networkPolicyEnforcement": {
      "name": "fs-test-enforcement"
    },
    "existingSCC": {
      "name": "fs-test-existing-scc"
    }
  },
  "namespaceBindingsPath": "/etc/falcone/namespace-bindings.json",
  "leaderElectionLeaseName": "falcone-pool-controller-leader",
  "scalerLeaseName": "falcone-pool-controller-scaler",
  "leaseDurationSeconds": 15,
  "renewDeadlineSeconds": 10,
  "retryPeriodSeconds": 2,
  "falconeDesiredStateEndpoint": "https://fs-test-platform.example/desired-state",
  "falconeStatusEndpoint": "https://fs-test-platform.example/status",
  "serviceIdentitySecretName": "fs-test-service-identity",
  "metricsPort": 9090,
  "probePort": 8081
}
