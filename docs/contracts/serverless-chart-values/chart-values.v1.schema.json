{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:falcone:contracts:ctr-serverless-chart-values:v1",
  "title": "ctr-serverless-chart-values v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "images": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "controller": {
          "$ref": "#/$defs/image"
        },
        "worker": {
          "$ref": "#/$defs/image"
        },
        "compiler": {
          "$ref": "#/$defs/image"
        }
      },
      "required": [
        "controller",
        "worker",
        "compiler"
      ]
    },
    "watchedPoolNamespaces": {
      "$ref": "#/$defs/namespaces"
    },
    "controllerNamespace": {
      "$ref": "#/$defs/namespace"
    },
    "namespaceMode": {
      "type": "string",
      "const": "preprovisioned",
      "default": "preprovisioned"
    },
    "prerequisites": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gatewayRoute": {
          "$ref": "#/$defs/namedRef"
        },
        "storage": {
          "$ref": "#/$defs/namedRef"
        },
        "broker": {
          "$ref": "#/$defs/namedRef"
        },
        "networkPolicyEnforcement": {
          "$ref": "#/$defs/namedRef"
        },
        "existingSCC": {
          "$ref": "#/$defs/namedRef"
        },
        "rbac": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "controllerRoleBinding": {
              "$ref": "#/$defs/name"
            }
          },
          "required": [
            "controllerRoleBinding"
          ]
        }
      },
      "required": [
        "gatewayRoute",
        "storage",
        "broker",
        "networkPolicyEnforcement",
        "existingSCC",
        "rbac"
      ]
    },
    "namespaceBindingsPath": {
      "type": "string",
      "pattern": "^/\\S+$",
      "default": "/etc/falcone/namespace-bindings.json"
    },
    "falconeDesiredStateEndpoint": {
      "type": "string",
      "pattern": "^https://[^/@\\s?#]+(?:/[^\\s]*)?$"
    },
    "falconeStatusEndpoint": {
      "type": "string",
      "pattern": "^https://[^/@\\s?#]+(?:/[^\\s]*)?$"
    },
    "watchedOCINamespaces": {
      "$ref": "#/$defs/namespaces"
    },
    "platformRegistryPullSecretName": {
      "$ref": "#/$defs/name"
    },
    "oci": {
      "type": "object",
      "additionalProperties": false,
      "default": {
        "enabled": false
      },
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "shimImage": {
          "$ref": "#/$defs/image"
        }
      },
      "if": {
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "shimImage"
        ]
      },
      "else": {
        "not": {
          "required": [
            "shimImage"
          ]
        }
      }
    },
    "replicas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "controller": {
          "type": "integer",
          "minimum": 1,
          "maximum": 400
        },
        "worker": {
          "type": "integer",
          "minimum": 0,
          "maximum": 400
        },
        "compiler": {
          "type": "integer",
          "minimum": 1,
          "maximum": 400
        }
      }
    },
    "poolLimits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxPools": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "maxReplicasPerPool": {
          "type": "integer",
          "minimum": 1,
          "maximum": 400
        }
      }
    },
    "leaderElectionLeaseName": {
      "type": "string",
      "const": "falcone-pool-controller-leader",
      "default": "falcone-pool-controller-leader"
    },
    "scalerLeaseName": {
      "type": "string",
      "const": "falcone-pool-controller-scaler",
      "default": "falcone-pool-controller-scaler"
    },
    "leaseDurationSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600,
      "default": 15
    },
    "renewDeadlineSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600,
      "default": 10
    },
    "retryPeriodSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600,
      "default": 2
    },
    "metricsPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "default": 9090
    },
    "probePort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "default": 8081
    },
    "serviceIdentitySecretName": {
      "$ref": "#/$defs/name",
      "default": "falcone-controller-service-identity"
    }
  },
  "required": [
    "images",
    "watchedPoolNamespaces",
    "controllerNamespace",
    "prerequisites",
    "namespaceBindingsPath",
    "falconeDesiredStateEndpoint",
    "falconeStatusEndpoint"
  ],
  "$defs": {
    "namespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "namespaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/namespace"
      }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^\\S+$"
    },
    "namedRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        }
      },
      "required": [
        "name"
      ]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^(?:docker\\.io/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*|(?!localhost(?:/|$))[a-z0-9]+(?:(?:_|__|-+)[a-z0-9]+)*(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*|(?!localhost$)[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "repository",
        "digest"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "oci"
        ],
        "properties": {
          "oci": {
            "required": [
              "enabled"
            ],
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "watchedOCINamespaces",
          "platformRegistryPullSecretName"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "watchedOCINamespaces"
              ]
            },
            {
              "required": [
                "platformRegistryPullSecretName"
              ]
            }
          ]
        }
      }
    }
  ]
}
