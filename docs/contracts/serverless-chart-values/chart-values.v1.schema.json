{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ctr-serverless-chart-values/v1",
  "title": "Namespace-only serverless chart values v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "controller": {
      "$ref": "#/$defs/controller"
    },
    "worker": {
      "$ref": "#/$defs/worker"
    },
    "compiler": {
      "$ref": "#/$defs/compiler"
    },
    "namespaceMode": {
      "type": "string",
      "const": "preprovisioned",
      "default": "preprovisioned"
    },
    "watchedPoolNamespaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/namespace"
      }
    },
    "controllerNamespace": {
      "$ref": "#/$defs/namespace"
    },
    "namespaceBindingsPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/",
      "default": "/etc/falcone/namespace-bindings.json"
    },
    "leaderElectionLeaseName": {
      "const": "falcone-pool-controller-leader"
    },
    "scalerLeaseName": {
      "const": "falcone-pool-controller-scaler"
    },
    "leaseDurationSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600,
      "default": 15
    },
    "renewDeadlineSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600,
      "default": 10
    },
    "retryPeriodSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600,
      "default": 2
    },
    "falconeDesiredStateEndpoint": {
      "$ref": "#/$defs/httpsEndpoint"
    },
    "falconeStatusEndpoint": {
      "$ref": "#/$defs/httpsEndpoint"
    },
    "serviceIdentitySecretName": {
      "$ref": "#/$defs/name"
    },
    "platformRegistryPullSecretName": {
      "$ref": "#/$defs/name"
    },
    "metricsPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "default": 9090
    },
    "probePort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "default": 8081
    },
    "poolLimits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxPools": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maxReplicasPerPool": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "prerequisites": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gatewayRoute": {
          "$ref": "#/$defs/namedRef"
        },
        "storage": {
          "$ref": "#/$defs/namedRef"
        },
        "broker": {
          "$ref": "#/$defs/namedRef"
        },
        "networkPolicyEnforcement": {
          "$ref": "#/$defs/namedRef"
        },
        "existingSCC": {
          "$ref": "#/$defs/namedRef"
        },
        "rbac": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "controllerRoleBinding": {
              "$ref": "#/$defs/name"
            }
          }
        }
      }
    },
    "oci": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "intakeMirrorRepository": {
          "$ref": "#/$defs/repository"
        }
      }
    },
    "watchedOCINamespaces": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/namespace"
      }
    }
  },
  "required": [
    "controller",
    "worker",
    "compiler",
    "watchedPoolNamespaces",
    "controllerNamespace"
  ],
  "$defs": {
    "namespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(?![\\s\\S])"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*(?![\\s\\S])"
    },
    "namedRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "httpsEndpoint": {
      "type": "string",
      "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::[0-9]{1,5})?(?:/[A-Za-z0-9._~!$&()*+,;=:%/-]*)?(?![\\s\\S])"
    },
    "repository": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^(?:docker\\.io/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*|(?!localhost(?:/|$))[a-z0-9]+(?:(?:_|__|-+)[a-z0-9]+)*(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*)(?![\\s\\S])"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "minLength": 71,
          "maxLength": 71
        }
      },
      "required": [
        "repository",
        "digest"
      ]
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "$ref": "#/$defs/image"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      },
      "required": [
        "image"
      ]
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "$ref": "#/$defs/image"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "image"
      ]
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "$ref": "#/$defs/image"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      },
      "required": [
        "image"
      ]
    }
  },
  "if": {
    "required": [
      "oci"
    ],
    "properties": {
      "oci": {
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "const": true
          }
        }
      }
    }
  },
  "then": {
    "required": [
      "watchedOCINamespaces",
      "platformRegistryPullSecretName"
    ],
    "properties": {
      "watchedOCINamespaces": {
        "minItems": 1
      }
    }
  },
  "else": {
    "properties": {
      "watchedOCINamespaces": {
        "maxItems": 0
      }
    }
  }
}
