{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:falcone:contracts:language-profile-matrix:2",
  "title": "ctr-language-profile-matrix v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "matrixVersion",
    "profiles"
  ],
  "properties": {
    "matrixVersion": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "javascript",
        "python",
        "go"
      ],
      "properties": {
        "javascript": {
          "$ref": "#/$defs/profile"
        },
        "python": {
          "$ref": "#/$defs/profile"
        },
        "go": {
          "$ref": "#/$defs/profile"
        }
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "wasmtimeVersion",
        "wasiVersion",
        "toolchainVersion",
        "packageCatalogueVersion",
        "allowedInterfaces",
        "testedExamples",
        "diagnostics",
        "eolPolicy",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "status": {
          "enum": [
            "disabled",
            "enabled"
          ]
        },
        "wasmtimeVersion": {
          "oneOf": [
            {
              "const": "unqualified"
            },
            {
              "$ref": "#/$defs/exactVersion"
            }
          ]
        },
        "wasiVersion": {
          "oneOf": [
            {
              "const": "unqualified"
            },
            {
              "const": "none"
            },
            {
              "$ref": "#/$defs/exactVersion"
            }
          ]
        },
        "toolchainVersion": {
          "oneOf": [
            {
              "const": "unqualified"
            },
            {
              "$ref": "#/$defs/exactVersion"
            }
          ]
        },
        "packageCatalogueVersion": {
          "oneOf": [
            {
              "const": "unqualified"
            },
            {
              "$ref": "#/$defs/exactVersion"
            }
          ]
        },
        "allowedInterfaces": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*/[a-z][a-z0-9-]*@[0-9]+\\.[0-9]+\\.[0-9]+$"
          }
        },
        "testedExamples": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "diagnostics": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "WASM-NATIVE-LIBRARY",
              "WASM-GPU",
              "WASM-PROCESS-SPAWN",
              "WASM-INSTALL-HOOK",
              "WASM-PACKAGE-NOT-IN-CATALOGUE",
              "WASM-UNSUPPORTED-API"
            ]
          },
          "allOf": [
            {
              "contains": {
                "const": "WASM-NATIVE-LIBRARY"
              }
            },
            {
              "contains": {
                "const": "WASM-GPU"
              }
            },
            {
              "contains": {
                "const": "WASM-PROCESS-SPAWN"
              }
            },
            {
              "contains": {
                "const": "WASM-INSTALL-HOOK"
              }
            },
            {
              "contains": {
                "const": "WASM-PACKAGE-NOT-IN-CATALOGUE"
              }
            },
            {
              "contains": {
                "const": "WASM-UNSUPPORTED-API"
              }
            }
          ]
        },
        "eolPolicy": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "compatibility": {
              "$ref": "#/$defs/evidenceRecord"
            },
            "adversarial": {
              "$ref": "#/$defs/evidenceRecord"
            },
            "leakage": {
              "$ref": "#/$defs/evidenceRecord"
            },
            "crashRecovery": {
              "$ref": "#/$defs/evidenceRecord"
            }
          }
        },
        "toolchainPins": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tinygo",
            "go",
            "wasm_tools"
          ],
          "properties": {
            "tinygo": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "version",
                "source",
                "archive",
                "sha256"
              ],
              "properties": {
                "name": {
                  "const": "TinyGo"
                },
                "version": {
                  "const": "0.44.0"
                },
                "source": {
                  "const": "https://github.com/tinygo-org/tinygo/releases/download/v0.44.0/tinygo0.44.0.linux-amd64.tar.gz"
                },
                "archive": {
                  "const": "tinygo0.44.0.linux-amd64.tar.gz"
                },
                "sha256": {
                  "const": "ed0f45543a49ff2a99120a5a1b8814a0750e1fda1a66f8e2a0a172576134aaf9"
                }
              }
            },
            "go": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "version",
                "source",
                "archive",
                "sha256"
              ],
              "properties": {
                "name": {
                  "const": "Go"
                },
                "version": {
                  "const": "1.26.11"
                },
                "source": {
                  "const": "https://go.dev/dl/go1.26.11.linux-amd64.tar.gz"
                },
                "archive": {
                  "const": "go1.26.11.linux-amd64.tar.gz"
                },
                "sha256": {
                  "const": "9849f4e04ee35303714e34fbc3ac8ab44ea3e448a95aa182f91e3b9b79c710ec"
                }
              }
            },
            "wasm_tools": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "version",
                "source",
                "archive",
                "sha256"
              ],
              "properties": {
                "name": {
                  "const": "wasm-tools"
                },
                "version": {
                  "const": "1.258.3"
                },
                "source": {
                  "const": "https://github.com/bytecodealliance/wasm-tools/releases/download/v1.258.3/wasm-tools-1.258.3-x86_64-linux.tar.gz"
                },
                "archive": {
                  "const": "wasm-tools-1.258.3-x86_64-linux.tar.gz"
                },
                "sha256": {
                  "const": "99b486a9ddc19af0260cd5f98f3b709a60817a3acd20efc9c582d719caebbf6d"
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "description": "enabled-requires-evidence",
          "if": {
            "properties": {
              "status": {
                "const": "enabled"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "required": [
                  "compatibility",
                  "adversarial",
                  "leakage",
                  "crashRecovery"
                ],
                "properties": {
                  "compatibility": {
                    "$ref": "#/$defs/passingEvidence"
                  },
                  "adversarial": {
                    "$ref": "#/$defs/passingEvidence"
                  },
                  "leakage": {
                    "$ref": "#/$defs/passingEvidence"
                  },
                  "crashRecovery": {
                    "$ref": "#/$defs/passingEvidence"
                  }
                }
              }
            }
          }
        },
        {
          "description": "enabled-requires-exact-versions-and-examples",
          "if": {
            "properties": {
              "status": {
                "const": "enabled"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "wasmtimeVersion": {
                "$ref": "#/$defs/exactVersion"
              },
              "wasiVersion": {
                "oneOf": [
                  {
                    "const": "none"
                  },
                  {
                    "$ref": "#/$defs/exactVersion"
                  }
                ]
              },
              "toolchainVersion": {
                "$ref": "#/$defs/exactVersion"
              },
              "packageCatalogueVersion": {
                "$ref": "#/$defs/exactVersion"
              },
              "testedExamples": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "evidenceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "artifactId",
        "digest"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "failed",
            "passed"
          ]
        },
        "artifactId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "passingEvidence": {
      "allOf": [
        {
          "$ref": "#/$defs/evidenceRecord"
        },
        {
          "properties": {
            "status": {
              "const": "passed"
            }
          }
        }
      ]
    },
    "exactVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z]+([.-][0-9A-Za-z]+)*)?(\\+[0-9A-Za-z]+([.-][0-9A-Za-z]+)*)?$"
    }
  }
}
